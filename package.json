{
  "name": "netstat-parser",
  "version": "0.2.2",
  "private": true,
  "description": "webapp that parses multiple netstat files from computers and builds a graph",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "lint": "eslint .",
    "test:collector": "python3 -m unittest discover -s collector/tests -t collector",
    "gen:data": "node scripts/generate-datasets.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-no-unsanitized": "^4.1.5"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  }
}
